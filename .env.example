# ============================================
# BusaÍ SP - Configurações de Ambiente
# ============================================

# 1. Token da API Olho Vivo (SPTrans)
# Obtenha gratuitamente em: http://www.sptrans.com.br/desenvolvedores
# Se não for preenchido, o app funciona automaticamente no modo Demonstração / Simulador com linhas reais de SP.
SPTRANS_TOKEN=

# 2. Supabase (Opcional - para sincronização na nuvem de favoritos e login)
# Obtenha em: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Upstash Redis (Opcional - para cache distribuído em serverless)
# Se não configurado, o app usa cache em memória automático com TTL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
