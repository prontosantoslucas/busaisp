 }
 
 /* ==========================================================================
+   CARD DE RESULTADO DE ROTA — polimento de UX nível "app de mobilidade"
+   (hierarquia de leitura, micro-interações, entrada escalonada, skeleton).
+   Namespace próprio (.bus-route-*) para não afetar o .bus-card genérico
+   usado em Estações, Notícias, Favoritos e Itinerário de Linha.
+   ========================================================================== */
+.bus-route-card {
+  background: var(--bus-surface-elevated);
+  border: 1px solid var(--bus-border);
+  border-radius: var(--bus-radius-md);
+  padding: 16px;
+  cursor: pointer;
+  position: relative;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  opacity: 0;
+  transform: translateY(10px);
+  animation: slideUp 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
+  animation-delay: var(--route-card-delay, 0ms);
+  transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.2s ease, transform 0.12s ease;
+}
+
+.bus-route-card:hover {
+  background: var(--bus-surface-hover);
+  border-color: var(--bus-border-highlight);
+  transform: translateY(-2px);
+  box-shadow: var(--bus-shadow-raised);
+}
+
+.bus-route-card:active {
+  transform: scale(0.985);
+}
+
+.bus-route-card.is-selected {
+  border-color: var(--bus-violet);
+  background: var(--bus-surface-hover);
+  box-shadow: 0 0 0 1.5px var(--bus-violet), var(--bus-shadow-card);
+}
+
+.bus-route-card.is-selected::before {
+  content: '';
+  position: absolute;
+  left: 0;
+  top: 0;
+  bottom: 0;
+  width: 4px;
+  background: var(--bus-violet);
+}
+
+.bus-route-ribbon {
+  position: absolute;
+  top: 0;
+  right: 14px;
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  background: var(--bus-violet-ink);
+  color: #FFFFFF;
+  padding: 3px 10px 4px;
+  border-radius: 0 0 8px 8px;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.2px;
+  text-transform: uppercase;
+}
+
+.bus-route-check {
+  width: 22px;
+  height: 22px;
+  flex-shrink: 0;
+  border-radius: 50%;
+  background: var(--bus-violet);
+  color: #FFFFFF;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  animation: fadeIn 0.2s ease forwards;
+}
+
+/* Barra de composição do trajeto (proporção caminhada x ônibus x trem/metrô) */
+.bus-route-modebar {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  height: 5px;
+  border-radius: var(--bus-radius-full);
+  overflow: hidden;
+  background: var(--bus-surface-sunken);
+}
+
+.bus-route-modebar-seg {
+  height: 100%;
+  min-width: 6px;
+  border-radius: var(--bus-radius-full);
+  transition: flex-grow 0.2s ease;
+}
+
+.bus-route-stats {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  font-size: 11.5px;
+  color: var(--bus-text-secondary);
+  flex-wrap: wrap;
+}
+
+.bus-route-stats span {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.bus-fav-btn {
+  transition: transform 0.15s ease, color 0.15s ease;
+}
+
+.bus-fav-btn.is-pulsing {
+  animation: favPop 0.35s ease;
+}
+
+@keyframes favPop {
+  0% { transform: scale(1); }
+  40% { transform: scale(1.35); }
+  100% { transform: scale(1); }
+}
+
+/* Ponto pulsante ao lado do badge "em Xm" — reforça que é dado ao vivo */
+.bus-live-dot {
+  display: inline-block;
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: currentColor;
+  animation: livePulse 1.4s ease-in-out infinite;
+}
+
+@keyframes livePulse {
+  0%, 100% { opacity: 1; transform: scale(1); }
+  50% { opacity: 0.35; transform: scale(0.65); }
+}
+
+.bus-route-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  border-top: 1px solid var(--bus-border-subtle);
+  padding-top: 10px;
+  font-size: 12px;
+  color: var(--bus-text-secondary);
+}
+
+.bus-route-footer-cta {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  color: var(--bus-violet);
+  font-weight: 600;
+  transition: gap 0.15s ease, color 0.15s ease;
+}
+
+.bus-route-card:hover .bus-route-footer-cta {
+  gap: 6px;
+  color: var(--bus-violet-ink);
+}
+
+/* Skeleton de carregamento — imita a silhueta real dos cards em vez de um
+   spinner genérico, então a lista não "salta" quando os resultados chegam. */
+.bus-route-skeleton {
+  background: var(--bus-surface-elevated);
+  border: 1px solid var(--bus-border);
+  border-radius: var(--bus-radius-md);
+  padding: 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  opacity: 0;
+  animation: fadeIn 0.2s ease forwards;
+  animation-delay: var(--route-card-delay, 0ms);
+}
+
+.bus-skel-bar {
+  border-radius: var(--bus-radius-sm);
+  background: linear-gradient(90deg, var(--bus-surface-sunken) 25%, var(--bus-surface-hover) 50%, var(--bus-surface-sunken) 75%);
+  background-size: 200% 100%;
+  animation: skeletonShimmer 1.4s ease-in-out infinite;
+}
+
+@keyframes skeletonShimmer {
+  0% { background-position: 200% 0; }
+  100% { background-position: -200% 0; }
+}
+
+/* ==========================================================================
    TIPOGRAFIA & MODO LEITOR DE NOTÍCIAS
    ========================================================================== */
 .reader-article {
