diff --git a/src/app/globals.css b/src/app/globals.css
index d2d51ab..8c6365e 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -169,7 +169,36 @@ html, body {
 
 .bus-card.active {
   border-color: var(--bus-violet);
-  box-shadow: 0 0 0 1px var(--bus-violet);
+  box-shadow: var(--bus-shadow-raised), 0 0 0 1px var(--bus-violet);
+}
+
+/* Feedback de toque imediato — o cartão inteiro é clicável (seleciona a rota),
+   então precisa reagir no toque antes mesmo da seleção completar. Reaproveita
+   a propriedade "transform" já declarada na transition de .bus-card acima,
+   que nunca era usada. */
+.bus-card:active {
+  transform: scale(0.985);
+}
+
+/* Seta "Detalhes" no rodapé do cartão — leve nudge no hover/toque do cartão
+   pra reforçar affordance de navegação, sem introduzir cor nova. */
+.bus-card-cta-arrow {
+  display: flex;
+  transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
+}
+.bus-card:hover .bus-card-cta-arrow,
+.bus-card:active .bus-card-cta-arrow {
+  transform: translateX(3px);
+}
+
+/* Feedback de toque para elementos tocáveis dentro do cartão (favoritar,
+   badges de linha que abrem o modal de partidas) — mesma curva "spring-like"
+   já usada em .animate-slide-up, só que aplicada a um toque de ícone/botão. */
+.bus-tap-feedback {
+  transition: transform 0.12s cubic-bezier(0.16, 1, 0.3, 1);
+}
+.bus-tap-feedback:active {
+  transform: scale(0.88);
 }
 
 /* Badges de Linha — pílula sólida, como um número de linha em painel real */
@@ -431,6 +460,30 @@ html, body {
   animation: fadeIn 0.2s ease forwards;
 }
 
+/* Entrada escalonada de itens de lista (ex.: cartões de rota) — reaproveita o
+   keyframe slideUp já existente, só que com fill-mode "both" para que o item
+   fique invisível durante o animation-delay em vez de piscar visível antes de
+   sua vez. Combine com um animationDelay inline incremental por item. */
+.bus-card-enter {
+  animation: slideUp 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+
+/* ==========================================================================
+   SKELETON DE CARREGAMENTO — usado quando a forma final do conteúdo já é
+   previsível (ex.: lista de cartões de rota), no lugar de um spinner
+   genérico. Deriva das superfícies já existentes (sunken/elevated), não
+   introduz cor nova.
+   ========================================================================== */
+@keyframes skeletonPulse {
+  0%, 100% { opacity: 0.55; }
+  50% { opacity: 1; }
+}
+
+.bus-skeleton {
+  background: var(--bus-surface-sunken);
+  animation: skeletonPulse 1.4s ease-in-out infinite;
+}
+
 /* ==========================================================================
    LEAFLET CUSTOMIZATION
    ========================================================================== */
