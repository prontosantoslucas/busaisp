+/* Botão de ícone pequeno (limpar busca, enviar formulário, fechar) — mesma
+   disciplina tátil de .bus-btn-primary/.bus-btn-voice (scale no toque),
+   generalizada para os botões-ícone ad hoc que ainda não tinham feedback. */
+.bus-icon-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  background: transparent;
+  border: none;
+  color: var(--bus-text-secondary);
+  cursor: pointer;
+  transition: background-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
+}
+
+.bus-icon-btn:hover {
+  background: var(--bus-surface-hover);
+  color: var(--bus-text-primary);
+}
+
+.bus-icon-btn:active {
+  transform: scale(0.92);
+}
+
+/* Variante preenchida (ex.: botão de enviar busca) — mesma convenção de
+   hover de .bus-btn-primary (violet-ink -> violet, sem escurecer pra cinza). */
+.bus-icon-btn-filled:hover {
+  background: var(--bus-violet);
+  color: #FFFFFF;
+}
+
+/* Item de lista do dropdown de sugestões — estado de toque real (:active),
+   não só :hover via JS inline (que não dispara em touch, o uso predominante
+   deste app). */
+.bus-suggestion-row {
+  transition: background-color 0.12s ease;
+}
+
+.bus-suggestion-row:hover {
+  background: var(--bus-surface-hover);
+}
+
+.bus-suggestion-row:active {
+  background: var(--bus-violet-soft);
+}
+
+/* Indicador de página (bolinhas do carrossel de destinos) com feedback tátil */
+.bus-dot {
+  transition: background-color 0.2s ease, width 0.2s ease, transform 0.1s ease;
+}
+
+.bus-dot:active {
+  transform: scale(0.85);
+}
+
+/* Painel clicável (ex.: atalho de notícias) — mesma superfície plana de
+   .bus-glass-panel, mas com resposta tátil ao toque e leve elevação no hover,
+   sem introduzir vidro/blur/glow. */
+.bus-panel-pressable {
+  transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
+}
+
+.bus-panel-pressable:hover {
+  border-color: var(--bus-border-highlight);
+  box-shadow: var(--bus-shadow-raised);
+}
+
+.bus-panel-pressable:active {
+  transform: scale(0.99);
+  background: var(--bus-surface-hover);
+}
+
+/* Skeleton de carregamento — usado quando a forma final do conteúdo é
+   previsível (ex.: card de rota em tempo real), no lugar de um spinner
+   genérico. Reaproveita os tokens de superfície existentes, sem cor nova. */
+@keyframes busSkeletonShimmer {
+  0% { background-position: -120% 0; }
+  100% { background-position: 220% 0; }
+}
+
+.bus-skeleton {
+  border-radius: var(--bus-radius-sm);
+  background: linear-gradient(
+    90deg,
+    var(--bus-surface-sunken) 25%,
+    var(--bus-surface-hover) 50%,
+    var(--bus-surface-sunken) 75%
+  );
+  background-size: 200% 100%;
+  animation: busSkeletonShimmer 1.4s ease-in-out infinite;
+}
+
