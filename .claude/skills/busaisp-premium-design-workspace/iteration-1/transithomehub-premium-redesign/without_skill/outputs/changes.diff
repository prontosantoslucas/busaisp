 }
+
+/* ==========================================================================
+   TELA INICIAL "PREMIUM" (TransitHomeHub) — glassmorphism + micro-animações
+   no nível Uber/Waze. Escopado com prefixo `thh-` para não vazar para o
+   resto do app, que mantém o design system plano original.
+   ========================================================================== */
+
+.thh-hub {
+  position: relative;
+  isolation: isolate;
+}
+
+/* Manchas de luz ambiente atrás dos cartões — dão profundidade ao vidro sem
+   depender de imagens; ficam atrás do conteúdo (z-index negativo) e não
+   capturam clique/toque. */
+.thh-orb {
+  position: absolute;
+  border-radius: 50%;
+  pointer-events: none;
+  z-index: -1;
+  filter: blur(46px);
+  opacity: 0.55;
+  animation: thhFloat 12s ease-in-out infinite;
+  will-change: transform;
+}
+
+.thh-orb--violet {
+  width: 220px;
+  height: 220px;
+  top: -60px;
+  left: -40px;
+  background: radial-gradient(circle, var(--bus-violet) 0%, transparent 70%);
+}
+
+.thh-orb--amber {
+  width: 180px;
+  height: 180px;
+  top: 160px;
+  right: -50px;
+  background: radial-gradient(circle, var(--bus-live) 0%, transparent 70%);
+  animation-delay: -6s;
+  animation-duration: 14s;
+}
+
+/* Cartão de vidro premium — fundo translúcido + desfoque real do que está
+   atrás (o mapa ao vivo, na Home), com friso de brilho no topo e elevação
+   suave ao interagir. */
+.thh-glass {
+  position: relative;
+  background: var(--bus-glass-bg);
+  backdrop-filter: blur(22px) saturate(160%);
+  -webkit-backdrop-filter: blur(22px) saturate(160%);
+  border: 1px solid var(--bus-glass-border);
+  border-radius: var(--bus-radius-lg);
+  box-shadow: var(--bus-shadow-glass);
+  overflow: hidden;
+  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
+    border-color 0.3s ease, background 0.3s ease;
+}
+
+.thh-glass::before {
+  content: '';
+  position: absolute;
+  inset: 0 0 auto 0;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, var(--bus-glass-sheen), transparent);
+  opacity: 0.7;
+}
+
+.thh-glass:hover {
+  transform: translateY(-2px);
+  box-shadow: var(--bus-shadow-glass-hover);
+  border-color: var(--bus-glass-border-strong);
+  background: var(--bus-glass-bg-hover);
+}
+
+.thh-glass:focus-within {
+  border-color: var(--bus-glass-border-strong);
+  box-shadow: var(--bus-shadow-glass-hover), 0 0 0 3px var(--bus-violet-soft);
+}
+
+/* Entrada escalonada — cada cartão sobe e some no lugar com um pequeno
+   atraso relativo ao anterior, como um "reveal" de app premium. */
+.thh-rise {
+  opacity: 0;
+  animation: thhRise 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
+}
+
+/* Input de busca "premium": vidro + realce de foco animado */
+.thh-input {
+  background: transparent;
+  border: 1px solid var(--bus-glass-border);
+  transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
+}
+
+.thh-input:focus {
+  border-color: var(--bus-violet);
+  box-shadow: 0 0 0 4px var(--bus-violet-soft);
+  background: var(--bus-glass-highlight);
+}
+
+/* Botão circular de ação (enviar busca / limpar) com "spring" no toque */
+.thh-icon-btn {
+  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, box-shadow 0.25s ease;
+}
+
+.thh-icon-btn:hover {
+  transform: scale(1.08);
+  box-shadow: 0 4px 14px -2px var(--bus-violet-soft);
+}
+
+.thh-icon-btn:active {
+  transform: scale(0.9);
+}
+
+/* Chips de destino rápido — vidro leve, elevação e brilho no hover/tap */
+.thh-chip {
+  background: var(--bus-glass-highlight);
+  backdrop-filter: blur(8px);
+  -webkit-backdrop-filter: blur(8px);
+  border: 1px solid var(--bus-glass-border);
+  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, border-color 0.2s ease,
+    box-shadow 0.25s ease;
+  opacity: 0;
+  animation: thhPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
+}
+
+.thh-chip:hover {
+  transform: translateY(-2px) scale(1.03);
+  border-color: var(--bus-glass-border-strong);
+  box-shadow: 0 6px 16px -6px var(--bus-violet-soft);
+}
+
+.thh-chip:active {
+  transform: scale(0.95);
+}
+
+/* Dropdown de sugestões — vidro + itens que deslizam da esquerda ao aparecer */
+.thh-suggestion {
+  transition: background-color 0.18s ease, transform 0.18s ease, padding-left 0.18s ease;
+  opacity: 0;
+  animation: thhFadeSlide 0.3s ease forwards;
+}
+
+.thh-suggestion:hover {
+  background: var(--bus-glass-highlight);
+  padding-left: 16px;
+}
+
+/* Botão primário premium — gradiente sutil + brilho que varre no hover.
+   Autocontido (não depende de .bus-btn-primary) para não herdar o visual
+   plano do resto do app. */
+.thh-btn-primary {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  border: none;
+  border-radius: var(--bus-radius-full);
+  color: #FFFFFF;
+  font-family: inherit;
+  font-weight: 700;
+  cursor: pointer;
+  background: linear-gradient(135deg, var(--bus-violet) 0%, var(--bus-violet-ink) 100%);
+  overflow: hidden;
+  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease, filter 0.2s ease;
+  box-shadow: 0 8px 20px -8px var(--bus-violet-soft);
+}
+
+.thh-btn-primary::after {
+  content: '';
+  position: absolute;
+  top: 0;
+  left: -60%;
+  width: 40%;
+  height: 100%;
+  background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.35), transparent);
+  transform: skewX(-20deg);
+  transition: left 0.6s ease;
+}
+
+.thh-btn-primary:hover::after {
+  left: 130%;
+}
+
+.thh-btn-primary:hover {
+  filter: brightness(1.06);
+  box-shadow: 0 10px 26px -6px var(--bus-violet-soft);
+}
+
+.thh-btn-primary:active {
+  transform: scale(0.97);
+}
+
+/* Ponto "ao vivo" com anel duplo pulsante — sensação de radar em tempo real */
+.thh-live-dot {
+  position: relative;
+  width: 10px;
+  height: 10px;
+}
+
+.thh-live-dot::before,
+.thh-live-dot::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  background: var(--bus-live);
+  animation: thhLivePulse 2s cubic-bezier(0.2, 0.6, 0.4, 1) infinite;
+}
+
+.thh-live-dot::after {
+  animation-delay: 0.6s;
+}
+
+.thh-live-dot-core {
+  position: relative;
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: var(--bus-live);
+  box-shadow: 0 0 8px 1px var(--bus-live-soft);
+}
+
+/* Skeleton "shimmer" para carregamento — substitui o spinner por algo que
+   já sugere a forma do conteúdo, como Uber/Waze fazem ao consultar rota. */
+.thh-skeleton {
+  position: relative;
+  overflow: hidden;
+  background: var(--bus-surface-sunken);
+  border-radius: var(--bus-radius-sm);
+}
+
+.thh-skeleton::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  transform: translateX(-100%);
+  background: linear-gradient(90deg, transparent, var(--bus-glass-sheen), transparent);
+  animation: thhShimmer 1.5s ease-in-out infinite;
+}
+
+/* Valor numérico que "reage" quando o dado ao vivo é atualizado */
+.thh-value-pop {
+  display: inline-flex;
+  animation: thhValuePop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
+}
+
+/* Ícone com leve "respiração" para chamar atenção sem ser um alarme */
+.thh-breathe {
+  animation: thhBreathe 2.6s ease-in-out infinite;
+}
+
+/* Seta de atalho que desliza para o lado quando o cartão-pai (vidro) recebe hover */
+.thh-arrow {
+  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
+}
+
+.thh-glass:hover .thh-arrow {
+  transform: translateX(4px);
+}
+
+@keyframes thhFloat {
+  0%, 100% { transform: translate(0, 0) scale(1); }
+  50% { transform: translate(14px, -18px) scale(1.08); }
+}
+
+@keyframes thhRise {
+  from { opacity: 0; transform: translateY(20px) scale(0.98); }
+  to { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+@keyframes thhPop {
+  from { opacity: 0; transform: translateY(6px) scale(0.9); }
+  to { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+@keyframes thhFadeSlide {
+  from { opacity: 0; transform: translateX(-8px); }
+  to { opacity: 1; transform: translateX(0); }
+}
+
+@keyframes thhLivePulse {
+  0% { transform: scale(1); opacity: 0.65; }
+  100% { transform: scale(2.6); opacity: 0; }
+}
+
+@keyframes thhShimmer {
+  100% { transform: translateX(100%); }
+}
+
+@keyframes thhValuePop {
+  0% { opacity: 0; transform: translateY(6px) scale(0.85); }
+  60% { opacity: 1; transform: translateY(-1px) scale(1.04); }
+  100% { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+@keyframes thhBreathe {
+  0%, 100% { transform: scale(1); opacity: 1; }
+  50% { transform: scale(1.12); opacity: 0.8; }
+}
+
+/* Respeita quem prefere menos movimento: mantém o "vidro" mas remove
+   deslocamentos, pulsos e varreduras contínuas. */
+@media (prefers-reduced-motion: reduce) {
+  .thh-orb {
+    animation: none;
+  }
+  .thh-rise,
+  .thh-chip,
+  .thh-suggestion {
+    animation: none;
+    opacity: 1;
+  }
+  .thh-glass:hover {
+    transform: none;
+  }
+  .thh-live-dot::before,
+  .thh-live-dot::after,
+  .thh-skeleton::after,
+  .thh-value-pop,
+  .thh-breathe,
+  .thh-btn-primary::after {
+    animation: none;
+  }
+}
